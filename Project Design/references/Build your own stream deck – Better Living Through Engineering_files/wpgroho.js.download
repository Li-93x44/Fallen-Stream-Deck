(function(){var e=window.WPGroHo||{};e.my_hash="";e.data={};e.renderers={};e.syncProfileData=function(a,t){if(!e.data[a]){e.data[a]={};var r=document.querySelectorAll("div.grofile-hash-map-"+a+" span");for(var n=0;n<r.length;n++){var o=r[n];e.data[a][o.className]=o.textContent}}e.appendProfileData(e.data[a],a,t)};e.appendProfileData=function(a,t,r){for(var n in a){if(typeof e.renderers[n]==="function"){return e.renderers[n](a[n],t,r,n)}var o=document.getElementById(r);if(o){var d=o.querySelector("h4");if(d){var i=document.createElement("p");i.className="grav-extra "+n;i.textContent=a[n];d.insertAdjacentElement("afterend",i)}}}};window.WPGroHo=e})();